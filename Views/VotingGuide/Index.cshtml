@model List<Candidate>

@{
    ViewData["Title"] = "My Voting Guide";

    // group the picked candidates by municipality
    var byMunicipality = Model.GroupBy(c => c.Position!.Municipality!);
}

<h1>@ViewData["Title"]</h1>

<div class="mb-3">
    @if (Model.Any())
    {
        <a asp-action="Print" class="btn btn-primary">Print guide</a>
        <form asp-action="Clear" method="post" class="d-inline">
            <button type="submit" class="btn btn-danger">Clear all</button>
        </form>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Your guide is empty. Browse the <a asp-controller="Candidates" asp-action="Index">candidates</a>
        and click <strong>Add to guide</strong> on the ones you want to vote for.
    </div>
}

@foreach (var municipality in byMunicipality)
{
    <div class="card mb-4">
        <div class="card-header">
            <strong>@municipality.Key.Name</strong> &middot;
            <small>Election Date: @municipality.Key.ElectionDate.ToString("dddd, MMMM d, yyyy")</small>
        </div>
        <div class="card-body">
            @foreach (var position in municipality.GroupBy(c => c.Position!))
            {
                var selected = position.Count();
                var seats = position.Key.SeatsAvailable;

                <h6>
                    @position.Key.Name
                    (@selected of @seats seat@(seats == 1 ? "" : "s"))
                </h6>

                @if (selected > seats)
                {
                    <div class="alert alert-warning">
                        You picked @selected candidates but only @seats can be elected for @position.Key.Name.
                    </div>
                }

                <ul class="list-group mb-3">
                    @foreach (var candidate in position)
                    {
                        var photo = candidate.PhotoFileName == null
                            ? Url.Content("~/images/placeholder-candidate.svg")
                            : Url.Content($"~/uploads/{candidate.PhotoFileName}");

                        <li class="list-group-item d-flex align-items-center gap-3">
                            <img src="@photo" alt="Photo of @candidate.Name" width="48" height="48" class="rounded object-fit-cover" />
                            <a asp-controller="Candidates" asp-action="Details" asp-route-id="@candidate.CandidateId" class="flex-grow-1">@candidate.Name</a>
                            <form asp-action="Remove" asp-route-id="@candidate.CandidateId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}
