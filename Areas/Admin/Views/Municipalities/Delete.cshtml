@model Municipality

@{
    ViewData["Title"] = "Delete Municipality";
    var candidateCount = Model.Positions.Sum(p => p.Candidates.Count);
}

<h1>@ViewData["Title"]</h1>
<h3>Are you sure you want to delete this?</h3>

<div class="alert alert-warning">
    This will also delete its @Model.Positions.Count positions, @candidateCount candidates
    and the "@Model.AdminRoleName" group.
</div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Province)</dt>
    <dd class="col-sm-9">@Model.Province</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ElectionDate)</dt>
    <dd class="col-sm-9">@Model.ElectionDate.ToString("MMMM d, yyyy")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="MunicipalityId" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
