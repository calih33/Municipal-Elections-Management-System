@model IEnumerable<Municipality>

@{
    ViewData["Title"] = "Manage Municipalities";
    var isSuperAdmin = User.IsInRole(AppRoles.SuperAdmin);
}

<h1>@ViewData["Title"]</h1>

<p>
    @if (isSuperAdmin)
    {
        <a asp-action="Create" class="btn btn-success">Create New</a>
    }
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.LogoFileName)</th>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.Province)</th>
                <th>@Html.DisplayNameFor(model => model.ElectionDate)</th>
                <th>Positions</th>
                <th>@Html.DisplayNameFor(model => model.AdminRoleName)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                // placeholder if no logo
                var logo = item.LogoFileName == null
                    ? Url.Content("~/images/placeholder-logo.svg")
                    : Url.Content($"~/uploads/{item.LogoFileName}");

                <tr>
                    <td><img src="@logo" alt="@item.Name logo" width="48" height="48" class="object-fit-contain" /></td>
                    <td>@item.Name</td>
                    <td>@item.Province</td>
                    <td>@item.ElectionDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.Positions.Count</td>
                    <td>@item.AdminRoleName</td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.MunicipalityId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.MunicipalityId" class="btn btn-sm btn-info">Details</a>
                        @if (isSuperAdmin)
                        {
                            <a asp-action="Delete" asp-route-id="@item.MunicipalityId" class="btn btn-sm btn-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
