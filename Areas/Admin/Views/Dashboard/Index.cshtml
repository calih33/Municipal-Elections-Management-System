@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>@ViewData["Title"]</h1>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Municipalities</h5>
                <p class="card-text display-6">@ViewData["MunicipalityCount"]</p>
                <a asp-controller="Municipalities" asp-action="Index" class="btn btn-primary">Manage</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Positions</h5>
                <p class="card-text display-6">@ViewData["PositionCount"]</p>
                <a asp-controller="Positions" asp-action="Index" class="btn btn-primary">Manage</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Candidates</h5>
                <p class="card-text display-6">@ViewData["CandidateCount"]</p>
                <a asp-controller="Candidates" asp-action="Index" class="btn btn-primary">Manage</a>
            </div>
        </div>
    </div>
</div>
