@model Candidate

@{
    ViewData["Title"] = "Delete Candidate";
}

<h1>@ViewData["Title"]</h1>
<h3>Are you sure you want to delete this?</h3>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">Municipality</dt>
    <dd class="col-sm-9">@Model.Position?.Municipality?.Name</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PositionId)</dt>
    <dd class="col-sm-9">@Model.Position?.Name</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="CandidateId" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>
