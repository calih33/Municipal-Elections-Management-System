@model IEnumerable<Position>

@{
    ViewData["Title"] = "Manage Positions";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Create New</a>
    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.MunicipalityId)</th>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.SeatsAvailable)</th>
                <th>Candidates</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Municipality?.Name</td>
                    <td>@item.Name</td>
                    <td>@item.SeatsAvailable</td>
                    <td>@item.Candidates.Count</td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.PositionId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.PositionId" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.PositionId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
